{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "12milia",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/poll/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "12milia-votes",
      "database_id": "f593a229-ac2f-43d4-97ad-2b88a497c508"
    }
  ]
}
